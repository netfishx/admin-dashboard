{
    "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
    "files": {
      "ignore": ["src/components/ui"]
    },
    "organizeImports": {
      "enabled": true
    },
    "linter": {
      "enabled": true,
      "rules": {
        "all": true,
        "suspicious": {
          "noExplicitAny": "info"
        },
        "a11y": {
          "useKeyWithClickEvents": "info"
        },
        "correctness": {
          "useExhaustiveDependencies": "warn",
          "noNodejsModules": "off"
        },
        "style": {
          "noDefaultExport": "off",
          "noImplicitBoolean": "off",
          "useNamingConvention": "off",
          "useFilenamingConvention": "off"
        },
        "complexity": {
          "noForEach": "warn"
        }
      }
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space"
    }
  }